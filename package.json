{
  "name": "java-title-screen-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:cloud": "node scripts/cloud-assets.mjs && npm run build",
    "rss": "node scripts/generate-rss.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs && npm run rss",
    "prebuild": "node scripts/prepare-pdf-assets.mjs && npm run content:validate && npm run rss && npm run rss:validate && node scripts/verify-classicube.mjs",
    "test:blog": "node tests/interactions/blog.mjs",
    "test:rss": "node tests/interactions/rss.mjs",
    "test:research": "node tests/interactions/research.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/create-mineworld-entry.mjs",
    "test": "node tests/interactions/menu.mjs",
    "test:panorama": "node tests/interactions/panorama.mjs",
    "test:profile": "node tests/interactions/profile.mjs",
    "format": "prettier --write src tests/interactions vite.config.ts",
    "test:research-paper": "node tests/interactions/research-paper.mjs",
    "test:research-shelf": "node tests/interactions/research-shelf.mjs",
    "test:wiki": "node tests/interactions/wiki.mjs",
    "test:status": "node tests/interactions/status.mjs",
    "test:startup": "node tests/interactions/startup.mjs",
    "test:world": "node tests/interactions/world.mjs",
    "rss:fetch": "node scripts/fetch-rss.mjs",
    "rss:validate": "node scripts/validate-rss.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "test:content": "node --test tests/rss-pipeline.test.mjs tests/content-search.test.mjs tests/paper-fulltext.test.mjs",
    "build:with-feeds": "npm run rss:fetch && npm run build",
    "rss:import": "node scripts/import-opml.mjs",
    "papers:verify": "node scripts/verify-paper-fulltexts.mjs && node scripts/apply-paper-fulltexts.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
